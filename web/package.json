{
    "name": "goexchange-dashboard",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc --noEmit && node -e \"require('node:fs').rmSync('../internal/dashboard/dist/assets', { recursive: true, force: true })\" && vite build",
        "test": "vitest run src",
        "test:e2e": "playwright test",
        "format": "prettier --write src e2e *.ts *.json",
        "preview": "vite preview --host 127.0.0.1"
    },
    "dependencies": {
        "@fontsource/instrument-serif": "5.3.0",
        "@fontsource/manrope": "5.3.0",
        "@radix-ui/react-slot": "1.3.3",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "lightweight-charts": "5.2.1",
        "lossless-json": "4.3.1",
        "lucide-react": "1.46.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "tailwind-merge": "3.7.0"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@tailwindcss/vite": "4.3.3",
        "@types/node": "26.5.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "prettier": "3.9.6",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.0.3"
    }
}
